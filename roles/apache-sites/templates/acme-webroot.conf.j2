# {{ ansible_managed }}
# ACME-Challenges (certbot --webroot) für alle vhosts.
Alias /.well-known/acme-challenge/ {{ apache_sites_acme_webroot }}/.well-known/acme-challenge/
<Directory {{ apache_sites_acme_webroot }}/.well-known/acme-challenge>
  Options None
  AllowOverride None
  Require all granted
</Directory>

<IfModule mod_ssl.c>
  SSLStaplingCache shmcb:/var/run/ocsp(128000)
</IfModule>
